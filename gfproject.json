{
  "package": {
    "name": "pi",
    "organization": "liii",
    "description": "Pi coding agent for Goldfish Scheme"
  },
  "domains": {
    "ai": {
      "root": "ai/",
      "mode": "r7rs"
    },
    "agent": {
      "root": "agent/",
      "depends-on": ["ai"],
      "mode": "r7rs"
    },
    "code": {
      "root": "code/",
      "depends-on": [
        "agent", "ai"
      ],
      "mode": "r7rs"
    },
    "tui": {
      "root": "tui/",
      "depends-on": [
        "code", "agent", "ai"
      ],
      "mode": "r7rs"
    },
    "simplify": {
      "root": "simplify/",
      "depends-on": [
        "agent", "code"
      ],
      "mode": "r7rs"
    },
    "web-search": {
      "root": "web-search/",
      "depends-on": [
        "agent", "code"
      ],
      "mode": "r7rs"
    },
    "review": {
      "root": "review/",
      "depends-on": [
        "agent", "code"
      ],
      "mode": "r7rs"
    }
  },
  "tools": {
    "pi": {
      "tools_dir": ".",
      "tool": "tui",
      "organization": "liii",
      "module": "pi/tui/cli",
      "description": {
        "en_US": "gf pi subcommand",
        "zh_CN": "gf pi 子命令"
      }
    }
  }
}
