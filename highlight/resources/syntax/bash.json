      "ld", "ld86", "ldd", "less", "lex", "locate",
      "lockfile", "logname", "lp", "lpr", "lynx", "m4",
      "make", "man", "msgfmt", "namei", "nasm", "nawk",
      "nice", "nl", "nm", "nm86", "nmap", "nohup",
