  "item-datas": {
    "Normal": "Normal",
    "Normal Text": "Normal",
    "Command": "Normal",
    "OtherCommand": "Normal",
    "Path": "Normal",
    "Keyword": "Keyword",
    "ControlFlow": "ControlFlow",
    "Builtin": "BuiltIn",
    "Function": "Function",
    "Variable": "Variable",
    "Parameter Expansion": "Variable",
    "Parameter Expansion Operator": "Operator",
    "Operator": "Operator",
    "Redirection": "Operator",
    "Option": "Attribute",
    "Glob": "SpecialChar",
    "Pattern": "SpecialChar",
    "Backquote": "SpecialChar",
    "Escape": "SpecialChar",
    "String Escape": "SpecialChar",
    "String": "String",
    "String Transl.": "String",
    "Comment": "Comment",
    "Decimal": "DecVal",
    "Hex": "BaseN",
    "Expression": "Operator",
    "File Descriptor": "DecVal",
    "Error": "Error"
  },
  "contexts": {
    "Normal": {
      "attribute": "Normal",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Normal", "context": "#stay" },
        { "type": "Detect2Chars", "attribute": "Comment", "context": "shebang", "char": "#", "char1": "!", "column": 0 },
        { "type": "DetectChar", "attribute": "Comment", "context": "comment", "char": "#" },
        { "type": "Detect2Chars", "attribute": "Parameter Expansion", "context": "var-brace", "char": "$", "char1": "{" },
        { "type": "Detect2Chars", "attribute": "Parameter Expansion", "context": "subst-command", "char": "$", "char1": "(" },
        { "type": "DetectChar", "attribute": "Variable", "context": "dollar", "char": "$", "look-ahead": true },
        { "type": "DetectChar", "attribute": "String", "context": "string-double", "char": "\"" },
        { "type": "DetectChar", "attribute": "String", "context": "string-single", "char": "'" },
        { "type": "DetectChar", "attribute": "Backquote", "context": "backquote", "char": "`" },
        { "type": "keyword", "attribute": "ControlFlow", "context": "#stay", "String": "keywords", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "keyword", "attribute": "Builtin", "context": "#stay", "String": "builtins", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "keyword", "attribute": "Builtin", "context": "#stay", "String": "builtins_var", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "keyword", "attribute": "Command", "context": "#stay", "String": "unixcommands", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "Hex", "attribute": "Hex", "context": "#stay" },
        { "type": "Float", "attribute": "Decimal", "context": "#stay" },
        { "type": "Int", "attribute": "Decimal", "context": "#stay", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "Detect2Chars", "attribute": "Operator", "context": "#stay", "char": "&", "char1": "&" },
        { "type": "Detect2Chars", "attribute": "Operator", "context": "#stay", "char": "|", "char1": "|" },
        { "type": "AnyChar", "attribute": "Operator", "context": "#stay", "String": "&|;" },
        { "type": "Detect2Chars", "attribute": "Redirection", "context": "#stay", "char": ">", "char1": ">" },
        { "type": "Detect2Chars", "attribute": "Redirection", "context": "#stay", "char": ">", "char1": "&" },
        { "type": "Detect2Chars", "attribute": "Redirection", "context": "#stay", "char": "<", "char1": "<" },
        { "type": "Detect2Chars", "attribute": "Redirection", "context": "#stay", "char": "<", "char1": ">" },
        { "type": "DetectChar", "attribute": "Redirection", "context": "#stay", "char": ">" },
        { "type": "DetectChar", "attribute": "Redirection", "context": "#stay", "char": "<" },
        { "type": "AnyChar", "attribute": "Operator", "context": "#stay", "String": "+-*/%=!~^" },
        { "type": "AnyChar", "attribute": "Normal", "context": "#stay", "String": "()[]{}.,:" },
        { "type": "DetectIdentifier", "attribute": "Normal", "context": "#stay" }
      ]
    },
    "shebang": {
      "attribute": "Comment",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Comment", "context": "#stay" },
        { "type": "DetectIdentifier", "attribute": "Comment", "context": "#stay" }
      ]
    },
    "comment": {
      "attribute": "Comment",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Comment", "context": "#stay" },
        { "type": "DetectIdentifier", "attribute": "Comment", "context": "#stay" }
      ]
    },
    "dollar": {
      "attribute": "Variable",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectChar", "attribute": "Variable", "context": "#stay", "char": "$" },
        { "type": "DetectIdentifier", "attribute": "Variable", "context": "#pop" },
        { "type": "AnyChar", "attribute": "Variable", "context": "#pop", "String": "*@#?$!0123456789-" }
      ]
    },
    "var-brace": {
      "attribute": "Variable",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectChar", "attribute": "Parameter Expansion", "context": "#pop", "char": "}" },
        { "type": "DetectIdentifier", "attribute": "Variable", "context": "#stay" },
        { "type": "AnyChar", "attribute": "Variable", "context": "#stay", "String": "*@#?$!-_0123456789" },
        { "type": "AnyChar", "attribute": "Parameter Expansion Operator", "context": "#stay", "String": ":-=?+#%/,^@" },
        { "type": "DetectChar", "attribute": "String", "context": "string-double", "char": "\"" },
        { "type": "DetectChar", "attribute": "String", "context": "string-single", "char": "'" }
      ]
    },
    "subst-command": {
      "attribute": "Normal",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectChar", "attribute": "Parameter Expansion", "context": "#pop", "char": ")" },
        { "type": "DetectSpaces", "attribute": "Normal", "context": "#stay" },
        { "type": "DetectChar", "attribute": "Comment", "context": "comment", "char": "#" },
        { "type": "Detect2Chars", "attribute": "Parameter Expansion", "context": "var-brace", "char": "$", "char1": "{" },
        { "type": "DetectChar", "attribute": "Variable", "context": "dollar", "char": "$", "look-ahead": true },
        { "type": "DetectChar", "attribute": "String", "context": "string-double", "char": "\"" },
        { "type": "DetectChar", "attribute": "String", "context": "string-single", "char": "'" },
        { "type": "DetectChar", "attribute": "Backquote", "context": "backquote", "char": "`" },
        { "type": "keyword", "attribute": "ControlFlow", "context": "#stay", "String": "keywords", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "keyword", "attribute": "Builtin", "context": "#stay", "String": "builtins", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "keyword", "attribute": "Command", "context": "#stay", "String": "unixcommands", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "Int", "attribute": "Decimal", "context": "#stay", "delimiters": " \t\r\n()[]{}\",'`;\\.:=+-*/%^#~<>&|" },
        { "type": "AnyChar", "attribute": "Operator", "context": "#stay", "String": "+-*/%=!~^&|;<>" },
        { "type": "AnyChar", "attribute": "Normal", "context": "#stay", "String": "()[]{}" },
        { "type": "DetectIdentifier", "attribute": "Normal", "context": "#stay" }
      ]
    },
    "string-double": {
      "attribute": "String",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectChar", "attribute": "String", "context": "#pop", "char": "\"" },
        { "type": "Detect2Chars", "attribute": "String", "context": "var-brace", "char": "$", "char1": "{" },
        { "type": "Detect2Chars", "attribute": "String", "context": "subst-command", "char": "$", "char1": "(" },
        { "type": "DetectChar", "context": "escape", "char": "\\", "look-ahead": true },
        { "type": "DetectChar", "context": "dollar-in-string", "char": "$", "look-ahead": true },
        { "type": "DetectChar", "attribute": "Backquote", "context": "backquote", "char": "`" }
      ]
    },
    "string-single": {
      "attribute": "String",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectChar", "attribute": "String", "context": "#pop", "char": "'" }
      ]
    },
    "dollar-in-string": {
      "attribute": "String",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectChar", "attribute": "Variable", "context": "#stay", "char": "$" },
        { "type": "DetectIdentifier", "attribute": "Variable", "context": "#pop" },
        { "type": "AnyChar", "attribute": "Variable", "context": "#pop", "String": "*@#?!0123456789-" }
      ]
    },
    "escape": {
      "attribute": "Escape",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Escape", "context": "#pop" },
        { "type": "DetectIdentifier", "attribute": "Escape", "context": "#pop" },
        { "type": "AnyChar", "attribute": "Escape", "context": "#pop", "String": "\"'`$\\" }
      ]
    },
    "backquote": {
      "attribute": "Normal",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectChar", "attribute": "Backquote", "context": "#pop", "char": "`" },
        { "type": "DetectSpaces", "attribute": "Normal", "context": "#stay" },
        { "type": "DetectChar", "attribute": "Comment", "context": "comment", "char": "#" },
        { "type": "DetectChar", "attribute": "Variable", "context": "dollar", "char": "$", "look-ahead": true },
        { "type": "DetectChar", "attribute": "String", "context": "string-double", "char": "\"" },
        { "type": "DetectChar", "attribute": "String", "context": "string-single", "char": "'" },
        { "type": "DetectIdentifier", "attribute": "Normal", "context": "#stay" },
        { "type": "AnyChar", "attribute": "Operator", "context": "#stay", "String": "+-*/%=!~^&|;<>()[]{}" }
      ]
    }
  }
}
