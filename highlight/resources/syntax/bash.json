      "false", "fgconsole", "fgrep", "fold", "fuser", "gawk",
      "getkeycodes", "gocr", "grep", "groff", "groups", "gunzip",
      "gzexe", "gzip", "hostid", "hostname", "iconv", "igawk",
      "install", "kbd_mode", "kbdrate", "killall", "last", "lastb",
      "link", "ln", "loadkeys", "loadunimap", "login", "ls",
      "lsattr", "lsmod", "lsmod.old", "lzcat", "lzcmp", "lzdiff",
      "lzegrep", "lzfgrep", "lzgrep", "lzless", "lzma", "lzmainfo",
      "lzmore", "mapscrn", "md5sum", "mesg", "mkdir", "mkfifo",
