      "slogin", "snice", "sort", "sox", "split", "ssh",
      "ssh-add", "ssh-agent", "ssh-keygen", "ssh-keyscan", "strings", "strip",
      "sudo", "suidperl", "sum", "tac", "tail", "tee",
