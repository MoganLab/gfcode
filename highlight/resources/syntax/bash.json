      "printenv", "ps", "pstree", "ptx", "rbash", "readlink",
      "realpath", "red", "resizecons", "rm", "rmdir", "run-parts",
      "runcon", "sash", "sed", "setfont", "setkeycodes", "setleds",
      "setmetamode", "setserial", "sh", "sha1sum", "sha224sum", "sha256sum",
      "sha384sum", "sha512sum", "showkey", "shred", "shuf", "sleep",
      "ssed", "stat", "stdbuf", "stty", "su", "sync",
      "tar", "tempfile", "timeout", "touch", "tput", "troff",
