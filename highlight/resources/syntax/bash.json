      "co", "col", "comm", "cpio", "cpp", "cut",
      "dc", "diff", "diff3", "directomatic", "dirname", "env",
      "expr", "fbset", "file", "find", "flex", "flex++",
      "fmt", "free", "ftp", "funzip", "g++", "gc",
      "gcc", "clang", "clang++", "valgrind", "xdg-open", "cmake",
      "qmake", "svn", "git", "rsync", "gdb", "getent",
