  "contexts": {
    "Normal": {
      "attribute": "Normal Text",
      "line-end-context": "#stay",
      "rules": [
        {
          "type": "DetectSpaces",
          "attribute": "Normal Text",
          "context": "#stay"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Comment",
          "context": "comment-line",
          "char": "-",
          "char1": "-"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Comment",
          "context": "comment-block",
          "char": "/",
          "char1": "*"
        },
        {
          "type": "DetectChar",
          "attribute": "String",
          "context": "string",
          "char": "'"
        },
        {
          "type": "DetectChar",
          "attribute": "Identifier",
          "context": "user-identifier",
          "char": "\""
        },
        {
          "type": "Hex",
          "attribute": "Hex",
          "context": "#stay"
        },
        {
          "type": "Float",
          "attribute": "Float",
          "context": "#stay"
        },
        {
          "type": "Int",
          "attribute": "Decimal",
          "context": "#stay"
        },
        {
          "type": "keyword",
          "attribute": "Keyword",
          "context": "#stay",
          "String": "keywords",
          "delimiters": " \t\r\n(),;"
        },
        {
          "type": "keyword",
          "attribute": "Operator Keyword",
          "context": "#stay",
          "String": "operators",
          "delimiters": " \t\r\n(),;"
        },
        {
          "type": "keyword",
          "attribute": "ControlFlow",
          "context": "#stay",
          "String": "controlflow",
          "delimiters": " \t\r\n(),;"
        },
        {
          "type": "keyword",
          "attribute": "Function",
          "context": "#stay",
          "String": "functions",
          "delimiters": " \t\r\n(),;"
        },
        {
          "type": "keyword",
          "attribute": "Data Type",
          "context": "#stay",
          "String": "types",
          "delimiters": " \t\r\n(),;"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Operator",
          "context": "#stay",
          "char": "!",
          "char1": "="
        },
        {
          "type": "Detect2Chars",
          "attribute": "Operator",
          "context": "#stay",
          "char": "~",
          "char1": "="
        },
        {
          "type": "Detect2Chars",
          "attribute": "Operator",
          "context": "#stay",
          "char": "^",
          "char1": "="
