{
  "metadata": {
    "copyright": [
      "SPDX-FileCopyrightText: 2026 The Goldfish Scheme Authors",
      "SPDX-FileCopyrightText: C++ syntax derived from isocpp.xml by Alex Turbov <i.zaufi@gmail.com> (KDE syntax-highlighting)"
    ],
    "license": "SPDX-License-Identifier: MIT",
    "name": "C++"
  },
  "name": "C++",
  "extensions": [
    "*.cpp",
    "*.cxx",
    "*.cc",
    "*.c++",
    "*.hpp",
    "*.hxx",
    "*.hh",
    "*.h++",
    "*.h",
    "*.c"
  ],
  "initial-context": "Normal",
  "lists": {
    "controlflow": [
      "if", "else", "for", "while", "do", "switch", "case", "default",
      "return", "break", "continue", "goto", "try", "catch", "throw",
      "co_await", "co_yield", "co_return"
    ],
    "keywords": [
      "class", "struct", "union", "enum", "public", "private", "protected",
      "virtual", "override", "final", "friend", "template", "typename",
      "namespace", "using", "new", "delete", "this", "nullptr", "true",
      "false", "sizeof", "alignas", "alignof", "decltype", "static_assert",
      "noexcept", "explicit", "operator", "concept", "requires",
      "static_cast", "dynamic_cast", "reinterpret_cast", "const_cast",
      "typeid", "asm", "import", "module", "export"
    ],
    "types": [
      "void", "bool", "char", "int", "short", "long", "float", "double",
      "signed", "unsigned", "wchar_t", "char8_t", "char16_t", "char32_t",
      "size_t", "ssize_t", "int8_t", "int16_t", "int32_t", "int64_t",
      "uint8_t", "uint16_t", "uint32_t", "uint64_t", "intptr_t", "uintptr_t",
      "ptrdiff_t", "intmax_t", "uintmax_t", "time_t", "auto"
    ],
    "modifiers": [
      "const", "static", "extern", "mutable", "volatile", "thread_local",
      "register", "inline", "constexpr", "consteval", "constinit"
    ],
    "pp-directives": [
      "include", "define", "ifdef", "ifndef", "endif", "if", "else",
      "elif", "pragma", "undef", "error", "warning"
    ]
  },
  "item-datas": {
    "Normal": "Normal",
    "Keyword": "Keyword",
    "ControlFlow": "ControlFlow",
    "DataType": "DataType",
    "String": "String",
    "Char": "Char",
    "SpecialChar": "SpecialChar",
    "Comment": "Comment",
    "Preprocessor": "Preprocessor",
    "DecVal": "DecVal",
    "BaseN": "BaseN",
    "Float": "Float",
    "Operator": "Operator",
    "Error": "Error"
  },
  "contexts": {
    "Normal": {
      "attribute": "Normal",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Normal", "context": "#stay" },
        { "type": "DetectChar", "attribute": "Preprocessor", "context": "preprocessor", "char": "#", "first-non-space": true },
        { "type": "Detect2Chars", "attribute": "Comment", "context": "comment-block", "char": "/", "char1": "*" },
        { "type": "Detect2Chars", "attribute": "Comment", "context": "comment-line", "char": "/", "char1": "/" },
        { "type": "StringDetect", "attribute": "String", "context": "raw-string", "String": "R\"(" },
        { "type": "DetectChar", "attribute": "String", "context": "string", "char": "\"" },
        { "type": "DetectChar", "attribute": "Char", "context": "char", "char": "'" },
        { "type": "Hex", "attribute": "BaseN", "context": "#stay" },
        { "type": "Float", "attribute": "Float", "context": "#stay" },
        { "type": "Int", "attribute": "DecVal", "context": "#stay" },
        { "type": "keyword", "attribute": "ControlFlow", "context": "#stay", "String": "controlflow" },
        { "type": "keyword", "attribute": "DataType", "context": "#stay", "String": "types" },
        { "type": "keyword", "attribute": "DataType", "context": "#stay", "String": "modifiers" },
        { "type": "keyword", "attribute": "Keyword", "context": "#stay", "String": "keywords" },
        { "type": "Detect2Chars", "attribute": "Operator", "context": "#stay", "char": ":", "char1": ":" },
        { "type": "Detect2Chars", "attribute": "Operator", "context": "#stay", "char": "-", "char1": ">" },
        { "type": "AnyChar", "attribute": "Operator", "context": "#stay", "String": "+-*/%=<>!&|^~?:." },
        { "type": "DetectChar", "attribute": "Normal", "context": "#stay", "char": "{", "event": "brace-open" },
        { "type": "DetectChar", "attribute": "Normal", "context": "#stay", "char": "}", "event": "brace-close" },
        { "type": "DetectChar", "attribute": "Normal", "context": "#stay", "char": "[", "event": "bracket-open" },
        { "type": "DetectChar", "attribute": "Normal", "context": "#stay", "char": "]", "event": "bracket-close" },
        { "type": "DetectChar", "attribute": "Normal", "context": "#stay", "char": "(", "event": "paren-open" },
        { "type": "DetectChar", "attribute": "Normal", "context": "#stay", "char": ")", "event": "paren-close" },
        { "type": "AnyChar", "attribute": "Normal", "context": "#stay", "String": ",;" },
        { "type": "DetectIdentifier", "attribute": "Normal", "context": "#stay" }
      ]
    },
    "preprocessor": {
      "attribute": "Preprocessor",
      "line-end-context": "#pop",
      "rules": [
        { "type": "Detect2Chars", "attribute": "Comment", "context": "comment-block", "char": "/", "char1": "*" },
        { "type": "Detect2Chars", "attribute": "Comment", "context": "comment-line", "char": "/", "char1": "/" },
        { "type": "DetectChar", "attribute": "String", "context": "string", "char": "\"" },
        { "type": "DetectChar", "attribute": "String", "context": "include-angle", "char": "<" },
        { "type": "keyword", "attribute": "Preprocessor", "context": "#stay", "String": "pp-directives" },
        { "type": "DetectSpaces", "attribute": "Preprocessor", "context": "#stay" },
        { "type": "Hex", "attribute": "BaseN", "context": "#stay" },
        { "type": "Int", "attribute": "DecVal", "context": "#stay" },
        { "type": "DetectIdentifier", "attribute": "Preprocessor", "context": "#stay" }
      ]
    },
    "include-angle": {
      "attribute": "String",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectChar", "attribute": "String", "context": "#pop", "char": ">" }
      ]
    },
    "comment-line": {
      "attribute": "Comment",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Comment", "context": "#stay" },
        { "type": "DetectIdentifier", "attribute": "Comment", "context": "#stay" }
      ]
    },
    "comment-block": {
      "attribute": "Comment",
      "line-end-context": "#stay",
      "rules": [
        { "type": "Detect2Chars", "attribute": "Comment", "context": "#pop", "char": "*", "char1": "/" },
        { "type": "DetectSpaces", "attribute": "Comment", "context": "#stay" },
        { "type": "DetectIdentifier", "attribute": "Comment", "context": "#stay" }
      ]
    },
    "string": {
      "attribute": "String",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectChar", "attribute": "String", "context": "#pop", "char": "\"" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "\\" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "\"" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "n" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "t" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "r" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "0" }
      ]
    },
    "char": {
      "attribute": "Char",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectChar", "attribute": "Char", "context": "#pop", "char": "'" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "\\" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "'" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "n" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "t" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "r" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "0" }
      ]
    },
    "raw-string": {
      "attribute": "String",
      "line-end-context": "#stay",
      "rules": [
        { "type": "StringDetect", "attribute": "String", "context": "#pop", "String": ")\"" }
      ]
    }
  },
  "segments": {
    "version": 1,
    "default": "text",
    "root-scope": "top-level",
    "structures": [
      { "name": "brace", "role": "brace", "scope": "nested", "begin": "brace-open", "end": "brace-close", "children": ["brace", "paren", "bracket"], "on-eof": "emit-unclosed" },
      { "name": "paren", "role": "paren", "scope": "nested", "begin": "paren-open", "end": "paren-close", "children": ["brace", "paren", "bracket"], "on-eof": "emit-unclosed" },
      { "name": "bracket", "role": "bracket", "scope": "nested", "begin": "bracket-open", "end": "bracket-close", "children": ["brace", "paren", "bracket"], "on-eof": "emit-unclosed" }
    ]
  }
}
