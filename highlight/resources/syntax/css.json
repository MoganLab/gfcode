      "deg", "rad", "grad", "turn", "s", "ms", "Hz", "kHz", "dpi",
      "dpcm", "dppx"
    ],
    "atrules": [
      "media", "keyframes", "import", "font-face", "page", "supports",
      "charset", "namespace", "container", "layer", "scope", "starting-style"
    ],
    "pseudo-classes": [
      "active", "hover", "focus", "visited", "link", "checked",
      "disabled", "enabled", "empty", "first-child", "last-child",
      "only-child", "first-of-type", "last-of-type", "only-of-type",
      "nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type",
      "not", "is", "where", "has", "root", "target", "lang", "dir",
      "valid", "invalid", "required", "optional", "placeholder-shown",
      "read-only", "read-write", "in-range", "out-of-range", "default",
      "indeterminate", "fullscreen", "focus-within", "focus-visible",
      "any-link", "local-link", "scope", "host"
    ],
    "pseudo-elements": [
      "before", "after", "first-line", "first-letter", "selection",
      "placeholder", "marker", "backdrop", "cue", "grammar-error",
      "spelling-error", "part", "slotted"
    ]
  },
  "item-datas": {
    "Normal": "Normal",
    "Comment": "Comment",
    "String": "String",
    "SpecialChar": "SpecialChar",
    "AtRule": "Import",
    "Property": "Keyword",
    "ValueKeyword": "BuiltIn",
    "Color": "Constant",
    "Number": "DecVal",
    "Unit": "DataType",
    "Function": "Function",
    "Variable": "Variable",
    "Selector": "Attribute",
    "PseudoClass": "Attribute",
    "PseudoElement": "Attribute",
    "Operator": "Operator",
    "PropertySep": "Char",
    "BlockSym": "Normal",
    "Error": "Error"
  },
  "contexts": {
    "Base": {
      "attribute": "Normal",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Normal", "context": "#stay" },
        { "type": "Detect2Chars", "attribute": "Comment", "context": "comment", "char": "/", "char1": "*" },
        { "type": "Detect2Chars", "attribute": "Comment", "context": "comment-line", "char": "/", "char1": "/" },
        { "type": "DetectChar", "attribute": "AtRule", "context": "at-rule", "char": "@" },
        { "type": "DetectChar", "attribute": "String", "context": "string-double", "char": "\"" },
        { "type": "DetectChar", "attribute": "String", "context": "string-single", "char": "'" },
        { "type": "DetectChar", "attribute": "Variable", "context": "variable", "char": "-" },
        { "type": "DetectChar", "attribute": "BlockSym", "context": "rule-body", "char": "{" },
        { "type": "DetectChar", "attribute": "BlockSym", "context": "#stay", "char": "}" },
        { "type": "DetectChar", "attribute": "PseudoClass", "context": "pseudo", "char": ":" },
        { "type": "DetectChar", "attribute": "Operator", "context": "#stay", "char": "&" },
        { "type": "Detect2Chars", "attribute": "Operator", "context": "#stay", "char": ">", "char1": ">" },
        { "type": "AnyChar", "attribute": "Operator", "context": "#stay", "String": ">~+*," },
        { "type": "DetectIdentifier", "attribute": "Selector", "context": "#stay" }
      ]
    },
    "rule-body": {
      "attribute": "Normal",
      "line-end-context": "#stay",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Normal", "context": "#stay" },
        { "type": "Detect2Chars", "attribute": "Comment", "context": "comment", "char": "/", "char1": "*" },
        { "type": "Detect2Chars", "attribute": "Comment", "context": "comment-line", "char": "/", "char1": "/" },
        { "type": "DetectChar", "attribute": "String", "context": "string-double", "char": "\"" },
        { "type": "DetectChar", "attribute": "String", "context": "string-single", "char": "'" },
        { "type": "DetectChar", "attribute": "BlockSym", "context": "#stay", "char": "}" },
        { "type": "DetectChar", "attribute": "BlockSym", "context": "#stay", "char": "{" },
        { "type": "DetectChar", "attribute": "PropertySep", "context": "#stay", "char": ":" },
        { "type": "DetectChar", "attribute": "PropertySep", "context": "#stay", "char": ";" },
        { "type": "DetectChar", "attribute": "Variable", "context": "variable", "char": "-" },
        { "type": "CharsetRun", "attribute": "Number", "context": "value-suffix", "String": "0123456789.", "min": 1 },
        { "type": "keyword", "attribute": "Property", "context": "#stay", "String": "properties", "delimiters": " \t\r\n()[]{}\",'`;:.,+/*=~^!?" },
        { "type": "keyword", "attribute": "ValueKeyword", "context": "#stay", "String": "valuekeywords", "delimiters": " \t\r\n()[]{}\",'`;:.,+/*=~^!?" },
        { "type": "keyword", "attribute": "Color", "context": "#stay", "String": "colors", "delimiters": " \t\r\n()[]{}\",'`;:.,+/*=~^!?" },
        { "type": "DetectIdentifier", "attribute": "Function", "context": "#stay" }
      ]
    },
    "value-suffix": {
      "attribute": "Normal",
      "line-end-context": "#pop",
      "fallthrough-context": "#pop",
      "rules": [
        { "type": "keyword", "attribute": "Unit", "context": "#pop", "String": "units", "delimiters": " \t\r\n()[]{}\",'`;:.,0123456789" },
        { "type": "DetectIdentifier", "attribute": "Unit", "context": "#pop" }
      ]
    },
    "at-rule": {
      "attribute": "AtRule",
      "line-end-context": "#stay",
      "rules": [
        { "type": "keyword", "attribute": "AtRule", "context": "#stay", "String": "atrules" },
        { "type": "DetectChar", "attribute": "BlockSym", "context": "#pop!rule-body", "char": "{" },
        { "type": "DetectIdentifier", "attribute": "AtRule", "context": "#stay" },
        { "type": "DetectSpaces", "attribute": "AtRule", "context": "#stay" }
      ]
    },
    "pseudo": {
      "attribute": "PseudoClass",
      "line-end-context": "#pop",
      "fallthrough-context": "#pop",
      "rules": [
        { "type": "Detect2Chars", "attribute": "PseudoElement", "context": "pseudo-element", "char": ":", "char1": ":" },
        { "type": "keyword", "attribute": "PseudoClass", "context": "#pop", "String": "pseudo-classes", "delimiters": " \t\r\n()[]{}\",'`;:.,+/*=~^!?-" },
        { "type": "DetectIdentifier", "attribute": "PseudoClass", "context": "#pop" }
      ]
    },
    "pseudo-element": {
      "attribute": "PseudoElement",
      "line-end-context": "#pop",
      "fallthrough-context": "#pop",
      "rules": [
        { "type": "keyword", "attribute": "PseudoElement", "context": "#pop", "String": "pseudo-elements", "delimiters": " \t\r\n()[]{}\",'`;:.,+/*=~^!?-" },
        { "type": "DetectIdentifier", "attribute": "PseudoElement", "context": "#pop" }
      ]
    },
    "variable": {
      "attribute": "Variable",
      "line-end-context": "#pop",
      "fallthrough-context": "#pop",
      "rules": [
        { "type": "DetectIdentifier", "attribute": "Variable", "context": "#pop" }
      ]
    },
    "string-double": {
      "attribute": "String",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectChar", "attribute": "String", "context": "#pop", "char": "\"" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "\\" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "\"" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "n" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "t" }
      ]
    },
    "string-single": {
      "attribute": "String",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectChar", "attribute": "String", "context": "#pop", "char": "'" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "\\" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "'" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "n" },
        { "type": "Detect2Chars", "attribute": "SpecialChar", "context": "#stay", "char": "\\", "char1": "t" }
      ]
    },
    "comment": {
      "attribute": "Comment",
      "line-end-context": "#stay",
      "rules": [
        { "type": "Detect2Chars", "attribute": "Comment", "context": "#pop", "char": "*", "char1": "/" },
        { "type": "DetectSpaces", "attribute": "Comment", "context": "#stay" },
        { "type": "DetectIdentifier", "attribute": "Comment", "context": "#stay" }
      ]
    },
    "comment-line": {
      "attribute": "Comment",
      "line-end-context": "#pop",
      "rules": [
        { "type": "DetectSpaces", "attribute": "Comment", "context": "#stay" },
        { "type": "DetectIdentifier", "attribute": "Comment", "context": "#stay" }
      ]
    }
  }
}
