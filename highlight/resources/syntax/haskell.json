  "contexts": {
    "code": {
      "attribute": "Normal",
      "line-end-context": "#stay",
      "rules": [
        {
          "type": "StringDetect",
          "attribute": "Pragma",
          "context": "pragma",
          "String": "{-#"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Comment",
          "context": "block-comment",
          "char": "{",
          "char1": "-"
        },
        {
          "type": "StringDetect",
          "attribute": "Comment",
          "context": "line-comment",
          "String": "--"
        },
        {
          "type": "WordDetect",
          "attribute": "Keyword",
          "context": "import-ctx",
          "String": "import",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "keyword",
          "attribute": "Keyword",
          "context": "#stay",
          "String": "keywords",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "keyword",
          "attribute": "Function Prelude",
          "context": "#stay",
          "String": "prelude function",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "keyword",
          "attribute": "Type Prelude",
          "context": "#stay",
          "String": "prelude type",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "keyword",
          "attribute": "Data Prelude",
          "context": "#stay",
          "String": "prelude data",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "keyword",
          "attribute": "Class Prelude",
          "context": "#stay",
          "String": "prelude class",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "DetectChar",
          "attribute": "Char",
          "context": "char",
          "char": "'"
        },
        {
          "type": "DetectChar",
          "attribute": "String",
          "context": "string",
          "char": "\""
        },
        {
          "type": "DetectChar",
          "attribute": "Function Infix",
          "context": "infix",
          "char": "`"
        },
        {
          "type": "Hex",
          "attribute": "Hex",
          "context": "#stay"
        },
        {
          "type": "Float",
          "attribute": "Float",
          "context": "#stay"
        },
        {
          "type": "Int",
          "attribute": "Decimal",
          "context": "#stay"
        },
        {
          "type": "Detect2Chars",
          "attribute": "EnumFromTo",
          "context": "#stay",
          "char": ".",
          "char1": "."
        },
        {
          "type": "AnyChar",
          "attribute": "Operator",
          "context": "#stay",
          "String": "!#$%&*+/<=>?@^|~.:;-\\"
        },
        {
          "type": "AnyChar",
          "attribute": "Normal",
          "context": "#stay",
          "String": "()[]{},_"
        },
        {
          "type": "DetectIdentifier",
          "attribute": "Normal",
          "context": "#stay"
        }
      ]
    },
    "pragma": {
      "attribute": "Pragma",
      "line-end-context": "#stay",
      "rules": [
        {
          "type": "DetectSpaces",
          "attribute": "Pragma",
          "context": "#stay"
        },
        {
          "type": "keyword",
          "attribute": "Pragma",
          "context": "#stay",
          "String": "language_pragmas",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "DetectIdentifier",
          "attribute": "Pragma",
          "context": "#stay"
        },
        {
          "type": "StringDetect",
          "attribute": "Pragma",
          "context": "#pop",
          "String": "#-}"
        },
        {
          "type": "AnyChar",
          "attribute": "Pragma",
          "context": "#stay",
          "String": ",()[]"
        }
      ]
    },
    "line-comment": {
      "attribute": "Comment",
      "line-end-context": "#pop",
      "rules": [
        {
          "type": "DetectSpaces",
          "attribute": "Comment",
          "context": "#stay"
        },
        {
          "type": "DetectIdentifier",
          "attribute": "Comment",
          "context": "#stay"
        },
        {
          "type": "AnyChar",
          "attribute": "Comment",
          "context": "#stay",
          "String": "+-*/%=<>!&|^~?:;.,()[]{}#@$'\"`"
        }
      ]
    },
    "block-comment": {
      "attribute": "Comment",
      "line-end-context": "#stay",
      "rules": [
        {
          "type": "Detect2Chars",
          "attribute": "Comment",
          "context": "block-comment",
          "char": "{",
          "char1": "-"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Comment",
          "context": "#pop",
          "char": "-",
          "char1": "}"
        },
        {
          "type": "DetectSpaces",
          "attribute": "Comment",
          "context": "#stay"
        },
        {
          "type": "DetectIdentifier",
          "attribute": "Comment",
          "context": "#stay"
        },
        {
          "type": "AnyChar",
          "attribute": "Comment",
          "context": "#stay",
          "String": "+-*/%=<>!&|^~?:;.,()[]{}#@$'\"`"
        }
      ]
    },
    "char": {
      "attribute": "Char",
      "line-end-context": "#pop",
      "rules": [
        {
          "type": "DetectChar",
          "attribute": "Char",
          "context": "#pop",
          "char": "'"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Char",
          "context": "#stay",
          "char": "\\",
          "char1": "\\"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Char",
          "context": "#stay",
          "char": "\\",
          "char1": "'"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Char",
          "context": "#stay",
          "char": "\\",
          "char1": "n"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Char",
          "context": "#stay",
          "char": "\\",
          "char1": "t"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Char",
          "context": "#stay",
          "char": "\\",
          "char1": "r"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Char",
          "context": "#stay",
          "char": "\\",
          "char1": "0"
        },
        {
          "type": "DetectChar",
          "attribute": "Char",
          "context": "#stay",
          "char": "\\"
        }
      ]
    },
    "string": {
      "attribute": "String",
      "line-end-context": "#stay",
      "rules": [
        {
          "type": "DetectChar",
          "attribute": "String",
          "context": "#pop",
          "char": "\""
        },
        {
          "type": "Detect2Chars",
          "attribute": "String",
          "context": "#stay",
          "char": "\\",
          "char1": "\\"
        },
        {
          "type": "Detect2Chars",
          "attribute": "String",
          "context": "#stay",
          "char": "\\",
          "char1": "\""
        },
        {
          "type": "Detect2Chars",
          "attribute": "String",
          "context": "#stay",
          "char": "\\",
          "char1": "n"
        },
        {
          "type": "Detect2Chars",
          "attribute": "String",
          "context": "#stay",
          "char": "\\",
          "char1": "t"
        },
        {
          "type": "Detect2Chars",
          "attribute": "String",
          "context": "#stay",
          "char": "\\",
          "char1": "r"
        },
        {
          "type": "Detect2Chars",
          "attribute": "String",
          "context": "#stay",
          "char": "\\",
          "char1": "0"
        }
      ]
    },
    "infix": {
      "attribute": "Function Infix",
      "line-end-context": "#stay",
      "rules": [
        {
          "type": "DetectChar",
          "attribute": "Function Infix",
          "context": "#pop",
          "char": "`"
        },
        {
          "type": "keyword",
          "attribute": "Function Prelude",
          "context": "#stay",
          "String": "prelude function",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "DetectIdentifier",
          "attribute": "Function Infix",
          "context": "#stay"
        }
      ]
    },
    "import-ctx": {
      "attribute": "Normal",
      "line-end-context": "#pop",
      "rules": [
        {
          "type": "DetectSpaces",
          "attribute": "Normal",
          "context": "#stay"
        },
        {
          "type": "keyword",
          "attribute": "Keyword",
          "context": "#stay",
          "String": "import_keywords",
          "delimiters": " \t\r\n()[]{}\"'`;,."
        },
        {
          "type": "StringDetect",
          "attribute": "Comment",
          "context": "line-comment",
          "String": "--"
        },
        {
          "type": "Detect2Chars",
          "attribute": "Comment",
          "context": "block-comment",
          "char": "{",
          "char1": "-"
        },
        {
          "type": "DetectIdentifier",
          "attribute": "Type",
          "context": "#stay"
        },
        {
          "type": "DetectChar",
          "attribute": "Operator",
          "context": "#stay",
          "char": "("
        },
        {
          "type": "DetectChar",
          "attribute": "Operator",
          "context": "#stay",
          "char": ")"
        }
      ]
    }
  }
